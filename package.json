{
  "name": "icloud-mcp",
  "version": "0.0.0",
  "private": true,
  "description": "Local iCloud Mail MCP",
  "type": "module",
  "packageManager": "bun@1.3.14",
  "scripts": {
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
